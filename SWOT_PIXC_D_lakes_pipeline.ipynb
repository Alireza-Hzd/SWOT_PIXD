      "source": [
        "def read_pixc_water_pixels(nc_path: str) -> pd.DataFrame:\n",
        "    with nc.Dataset(nc_path, 'r') as ds:\n",
        "        grp = ds[PIXC_GROUP]\n",
        "\n",
        "        lat   = np.ma.filled(grp[LAT_VAR][:],    fill_value=np.nan).astype(float)\n",
        "        lon   = np.ma.filled(grp[LON_VAR][:],    fill_value=np.nan).astype(float)\n",
        "        h     = np.ma.filled(grp[HEIGHT_VAR][:], fill_value=np.nan).astype(float)\n",
        "        cls   = np.ma.filled(grp[CLASS_VAR][:],  fill_value=-1).astype(int)\n",
        "        geoid = np.ma.filled(grp['geoid'][:],    fill_value=np.nan).astype(float)\n",
        "        tide  = np.ma.filled(grp['solid_earth_tide'][:], fill_value=np.nan).astype(float)\n",
        "\n",
        "        if MIN_CROSS_TRACK_M is not None or MAX_CROSS_TRACK_M is not None:\n",
        "            ct = np.abs(np.ma.filled(grp['cross_track'][:], fill_value=np.nan).astype(float)) \\\n",
        "                 if 'cross_track' in grp.variables else None\n",
        "        else:\n",
        "            ct = None\n",
        "\n",
        "    # Orthometric height: subtract geoid and solid earth tide\n",
        "    h_ortho = h - geoid - tide\n",
        "\n",
        "    df = pd.DataFrame({\n",
        "        \"lat\": lat, \"lon\": lon,\n",
        "        \"height\": h_ortho,          # corrected orthometric height (m above MSL)\n",
        "        \"height_ellipsoidal\": h,    # original ellipsoidal height, kept for reference\n",
        "        \"geoid\": geoid,\n",
        "        \"solid_earth_tide\": tide,\n",
        "        \"classification\": cls\n",
        "    })\n",
        "    if ct is not None:\n",
        "        df[\"cross_track\"] = ct\n",
        "\n",
        "    df = df[df[\"classification\"].isin(WATER_CLASS_VALUES)]\n",
        "    if \"cross_track\" in df.columns:\n",
        "        if MIN_CROSS_TRACK_M is not None:\n",
        "            df = df[df[\"cross_track\"] >= MIN_CROSS_TRACK_M]\n",
        "        if MAX_CROSS_TRACK_M is not None:\n",
        "            df = df[df[\"cross_track\"] <= MAX_CROSS_TRACK_M]\n",
        "\n",
        "    df = df[np.isfinite(df[\"height\"])].copy()\n",
        "    return df.reset_index(drop=True)\n",
        "\n",
        "\n",
        "# ── Main loop ──────────────────────────────────────────────────────────────────\n",
        "import tempfile\n",
        "from tqdm.notebook import tqdm\n",
        "\n",
        "records = []\n",
        "\n",
        "for granule in tqdm(results, desc=\"Processing PIXC granules\"):\n",
        "    dt_str = get_granule_datetime(granule)\n",
        "\n",
        "    try:\n",
        "        with tempfile.TemporaryDirectory() as tmpdir:\n",
        "\n",
        "            # 1. Download\n",
        "            local_paths = earthaccess.download([granule], local_path=tmpdir)\n",
        "            nc_files = [str(p) for p in local_paths if str(p).endswith(\".nc\")]\n",
        "\n",
        "            if not nc_files:\n",
        "                print(f\"  [SKIP] No .nc file for {dt_str[:19]}\")\n",
        "                continue\n",
        "\n",
        "            nc_path = nc_files[0]\n",
        "\n",
        "            # 2. Read water pixels (now returns orthometric heights)\n",
        "            df_pixels = read_pixc_water_pixels(nc_path)\n",
        "\n",
        "            if df_pixels.empty:\n",
        "                print(f\"  [SKIP] No water pixels found in {dt_str[:19]}\")\n",
        "                records.append({\"datetime\": dt_str, \"mean_wse_m\": np.nan,\n",
        "                                \"median_wse_m\": np.nan, \"std_wse_m\": np.nan,\n",
        "                                \"n_pixels\": 0})\n",
        "                continue\n",
        "\n",
        "            # 3. Clip to lake shapefile\n",
        "            df_lake = filter_pixels_to_shapefile(df_pixels, lake_union)\n",
        "\n",
        "            # 4. Compute statistics\n",
        "            stats = compute_stats(df_lake)\n",
        "\n",
        "        records.append({\"datetime\": dt_str, **stats})\n",
        "        status = \"✓\" if stats[\"n_pixels\"] > 0 else \"○ (no pixels in lake)\"\n",
        "        print(f\"  {status} {dt_str[:19]}  \"\n",
        "              f\"mean={stats['mean_wse_m']:.3f} m  \"\n",
        "              f\"median={stats['median_wse_m']:.3f} m  \"\n",
        "              f\"n={stats['n_pixels']}\")\n",
        "\n",
        "    except Exception as exc:\n",
        "        print(f\"  [ERROR] {dt_str[:19]} — {exc}\")\n",
        "        records.append({\"datetime\": dt_str, \"mean_wse_m\": np.nan,\n",
        "                        \"median_wse_m\": np.nan, \"std_wse_m\": np.nan,\n",
        "                        \"n_pixels\": 0, \"error\": str(exc)})\n",
        "\n",
        "print(f\"\\nDone — processed {len(records)} granule(s).\")\n",
        "'''\n",
        "The correction applied per pixel is:\n",
        "h_orthometric = h_ellipsoidal - geoid - solid_earth_tide\n",
        "'''\n"
      ]
    },
    {
