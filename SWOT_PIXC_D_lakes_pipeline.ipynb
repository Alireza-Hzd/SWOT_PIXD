            "  • 2024-11-08T14:10:34  SWOT_L2_HR_PIXC_023_486_080R_20241108T141034_20241108T141045_PGD0_01\n",
            "  • 2024-11-19T12:33:22  SWOT_L2_HR_PIXC_024_208_080L_20241119T123322_20241119T123333_PGD0_01\n",
            "  • 2024-11-21T01:50:28  SWOT_L2_HR_PIXC_024_251_229R_20241121T015028_20241121T015040_PGD0_01\n",
            "  • 2024-11-21T01:50:39  SWOT_L2_HR_PIXC_024_251_230R_20241121T015039_20241121T015050_PGD0_01\n",
            "  • 2024-11-29T10:55:29  SWOT_L2_HR_PIXC_024_486_079R_20241129T105529_20241129T105540_PGD0_01\n",
