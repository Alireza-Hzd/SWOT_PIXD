    {
      "cell_type": "markdown",
      "id": "a1000012",
      "metadata": {
        "id": "a1000012"
      },
      "source": [
        "## 6. Load the Lake Shapefile"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a1000013",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 483
        },
        "id": "a1000013",
        "outputId": "405ee06c-9b9d-4b2a-8405-43a336635ae5"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "/tmp/ipykernel_2014/986595812.py:4: DeprecationWarning: The 'unary_union' attribute is deprecated, use the 'union_all()' method instead.\n",
            "  lake_union = lake_gdf.unary_union   # single geometry for point-in-polygon tests\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "CRS after reprojection : EPSG:4326\n",
            "Number of features     : 1\n",
            "Bounds (WGS84)         : [12.5430096  42.51484975 12.5571912  42.5223535 ]\n"
          ]
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 500x400 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ],
      "source": [
        "import geopandas as gpd\n",
        "\n",
        "lake_gdf = gpd.read_file(SHAPEFILE_PATH).to_crs(epsg=4326)  # ensure WGS84\n",
        "lake_union = lake_gdf.unary_union   # single geometry for point-in-polygon tests\n",
        "\n",
        "print(f\"CRS after reprojection : {lake_gdf.crs}\")\n",
        "print(f\"Number of features     : {len(lake_gdf)}\")\n",
        "print(f\"Bounds (WGS84)         : {lake_gdf.total_bounds}\")\n",
        "lake_gdf.plot(figsize=(5, 4), edgecolor='black', facecolor='lightblue')\n",
        "import matplotlib.pyplot as plt\n",
        "plt.title(\"Lake Mask Shapefile\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "a1000014",
      "metadata": {
        "id": "a1000014"
      },
      "source": [
        "## 7. Helper Functions"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a1000015",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "a1000015",
        "outputId": "7ca65126-69f5-4b55-868d-155ad5ab7bf3"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Helper functions defined.\n"
          ]
        }
      ],
      "source": [
        "import netCDF4 as nc\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from shapely.geometry import Point\n",
        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "\n",
        "def get_granule_datetime(granule) -> str:\n",
        "    \"\"\"Extract the start datetime string from a granule metadata dict.\"\"\"\n",
        "    try:\n",
        "        return granule['umm']['TemporalExtent']['RangeDateTime']['BeginningDateTime']\n",
        "    except KeyError:\n",
        "        return \"unknown\"\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "def filter_pixels_to_shapefile(df: pd.DataFrame, polygon) -> pd.DataFrame:\n",
        "    \"\"\"\n",
        "    Keep only pixels whose (lon, lat) falls inside `polygon` (shapely geometry).\n",
        "    Uses a fast bounding-box pre-filter before the exact point-in-polygon test.\n",
        "    \"\"\"\n",
        "    if df.empty:\n",
        "        return df\n",
        "\n",
        "    # Bounding-box pre-filter\n",
        "    minx, miny, maxx, maxy = polygon.bounds\n",
        "    df = df[\n",
        "        (df[\"lon\"] >= minx) & (df[\"lon\"] <= maxx) &\n",
        "        (df[\"lat\"] >= miny) & (df[\"lat\"] <= maxy)\n",
        "    ].copy()\n",
        "\n",
        "    if df.empty:\n",
        "        return df\n",
        "\n",
        "    # Exact point-in-polygon\n",
        "    inside = df.apply(\n",
        "        lambda row: polygon.contains(Point(row[\"lon\"], row[\"lat\"])), axis=1\n",
        "    )\n",
        "    return df[inside].copy().reset_index(drop=True)\n",
        "\n",
        "\n",
        "def compute_stats(df: pd.DataFrame) -> dict:\n",
        "    \"\"\"Return mean, median, std WSE and pixel count.\"\"\"\n",
        "    if df.empty:\n",
        "        return {\"mean_wse_m\": np.nan, \"median_wse_m\": np.nan,\n",
        "                \"std_wse_m\": np.nan, \"n_pixels\": 0}\n",
        "    h = df[\"height\"].values\n",
        "    return {\n",
        "        \"mean_wse_m\"   : float(np.mean(h)),\n",
        "        \"median_wse_m\" : float(np.median(h)),\n",
        "        \"std_wse_m\"    : float(np.std(h)),\n",
        "        \"n_pixels\"     : int(len(h)),\n",
        "    }\n",
        "\n",
        "\n",
        "print(\"Helper functions defined.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "a1000016",
      "metadata": {
        "id": "a1000016"
      },
      "source": [
        "## 8. Main Loop — Download, Filter, Compute Statistics"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a1000017",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
