        "id": "a1000007",
        "outputId": "94edfa76-ae71-4ff8-da1c-7ec2877ff7b0"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Configuration loaded.\n",
            "  Product    : SWOT_L2_HR_PIXC_D\n",
            "  BBOX       : (12.542019, 42.51716, 12.558057, 42.52306)\n",
            "  Date range : 2024-11-01  →  2025-02-28\n",
            "  Shapefile  : /content/drive/Shareddrives/GRAW_Sapienza_Team/SWOT/Recentino /CSG_k-means_mask_kmeans_lake_final.shp\n"
          ]
        }
      ],
      "source": [
        "# ── USER SETTINGS ─────────────────────────────────────────────────────────────\n",
        "\n",
        "# Bounding box: (lon_min, lat_min, lon_max, lat_max)  [WGS84 degrees]\n",
        "LAKE_BBOX = (12.542019, 42.517160, 12.558057, 42.523060)\n",
        "\n",
        "# Date range for SWOT acquisitions\n",
        "DATE_START = \"2024-11-01\"   # ← change as needed\n",
        "DATE_END   = \"2025-02-28\"   # ← change as needed\n",
        "\n",
        "# Shapefile used to spatially filter pixels\n",
        "SHAPEFILE_PATH = (\n",
        "    \"/content/drive/Shareddrives/GRAW_Sapienza_Team/SWOT/Recentino /\"\n",
        "    \"CSG_k-means_mask_kmeans_lake_final.shp\"\n",
        ")\n",
        "\n",
        "# SWOT Pixel Cloud Version D — NASA short name & collection concept ID\n",
        "SWOT_SHORT_NAME      = \"SWOT_L2_HR_PIXC_D\"\n",
        "SWOT_COLLECTION_ID   = \"C3233944986-POCLOUD\"   # used as a fallback if short_name search fails\n",
        "\n",
        "# PIXC NetCDF group and variable names\n",
        "# All water-pixel data live in the '/pixel_cloud' group\n",
        "PIXC_GROUP          = \"pixel_cloud\"\n",
        "LAT_VAR             = \"latitude\"          # degrees_north\n",
        "LON_VAR             = \"longitude\"         # degrees_east\n",
        "HEIGHT_VAR          = \"height\"            # metres above WGS84 ellipsoid\n",
        "CLASS_VAR           = \"classification\"    # 3 = open water, 4 = dark water\n",
        "WATER_CLASS_VALUES  = [3, 4]              # pixel classes considered open water\n",
        "\n",
        "# Optional: filter by cross_track distance to remove near-nadir artifacts\n",
        "# Set to None to keep all pixels\n",
        "MIN_CROSS_TRACK_M   = None   # metres  (None to disable)\n",
        "MAX_CROSS_TRACK_M   = None     # metres  (None to disable)\n",
        "\n",
        "# Output CSV path\n",
        "OUTPUT_CSV = (\n",
        "    \"/content/drive/Shareddrives/GRAW_Sapienza_Team/SWOT/Recentino /\"\n",
        "    \"lake_wse_statistics_PIXC_D.csv\"\n",
        ")\n",
        "\n",
        "# ──────────────────────────────────────────────────────────────────────────────\n",
        "print(\"Configuration loaded.\")\n",
        "print(f\"  Product    : {SWOT_SHORT_NAME}\")\n",
        "print(f\"  BBOX       : {LAKE_BBOX}\")\n",
        "print(f\"  Date range : {DATE_START}  →  {DATE_END}\")\n",
        "print(f\"  Shapefile  : {SHAPEFILE_PATH}\")"
      ]
    },
