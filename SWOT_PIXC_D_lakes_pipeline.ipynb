        "    alpha=0.15, color=\"steelblue\", label=\"± 1σ (mean)\"\n",
        ")\n",
        "ax.plot(df_valid[\"datetime\"], df_valid[\"mean_wse_m\"],\n",
        "        marker=\"o\", lw=1.5, color=\"steelblue\", label=\"Mean WSE\")\n",
        "ax.plot(df_valid[\"datetime\"], df_valid[\"median_wse_m\"],\n",
        "        marker=\"s\", lw=1.5, ls=\"--\", color=\"tomato\", label=\"Median WSE\")\n",
        "\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"Water Surface Elevation (m, EGM2008)\")\n",
        "ax.set_title(\"SWOT PIXC Version D — Lake Water Level\")\n",
        "ax.xaxis.set_major_formatter(mdates.DateFormatter(\"%Y-%m-%d\"))\n",
        "ax.xaxis.set_major_locator(mdates.AutoDateLocator())\n",
        "plt.setp(ax.get_xticklabels(), rotation=30, ha=\"right\")\n",
        "ax.legend()\n",
        "ax.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
        "\n",
        "plot_path = OUTPUT_CSV.replace(\".csv\", \"_timeseries.png\")\n",
        "plt.savefig(plot_path, dpi=150)\n",
        "plt.show()\n",
        "print(f\"Plot saved to:\\n  {plot_path}\")"
      ]
    },
