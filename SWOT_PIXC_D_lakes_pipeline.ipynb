      "source": [
        "df_results = pd.DataFrame(records)\n",
        "df_results[\"datetime\"] = pd.to_datetime(df_results[\"datetime\"])\n",
        "df_results = df_results.sort_values(\"datetime\").reset_index(drop=True)\n",
        "\n",
        "# Keep only passes with at least one valid lake pixel\n",
        "df_valid = df_results[df_results[\"n_pixels\"] > 0].copy()\n",
        "\n",
        "display_cols = [\"datetime\", \"mean_wse_m\", \"median_wse_m\", \"std_wse_m\", \"n_pixels\"]\n",
        "print(f\"Passes with valid lake pixels: {len(df_valid)} / {len(df_results)}\")\n",
        "print()\n",
        "print(df_valid[display_cols].to_string(index=False))"
      ]
