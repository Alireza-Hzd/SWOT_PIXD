      "source": [
        "# Set GRANULE_INDEX to inspect any single granule visually.\n",
        "GRANULE_INDEX = 0\n",
        "\n",
        "with tempfile.TemporaryDirectory() as tmpdir:\n",
        "    local_paths = earthaccess.download([results[GRANULE_INDEX]], local_path=tmpdir)\n",
        "    nc_files = [str(p) for p in local_paths if str(p).endswith(\".nc\")]\n",
        "    df_px  = read_pixc_water_pixels(str(nc_files[0]))\n",
        "    df_lk  = filter_pixels_to_shapefile(df_px, lake_union)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "# All water pixels in the tile (bbox extent)\n",
        "sc0 = axes[0].scatter(df_px[\"lon\"], df_px[\"lat\"], c=df_px[\"height\"],\n",
        "                      cmap=\"Blues\", s=1, vmin=df_px[\"height\"].quantile(0.02),\n",
        "                                          vmax=df_px[\"height\"].quantile(0.98))\n",
        "lake_gdf.boundary.plot(ax=axes[0], color=\"red\", lw=1)\n",
        "plt.colorbar(sc0, ax=axes[0], label=\"WSE (m)\")\n",
        "axes[0].set_title(f\"All water pixels — {len(df_px)} pts\")\n",
        "\n",
        "# Pixels clipped to lake shapefile\n",
        "if not df_lk.empty:\n",
        "    sc1 = axes[1].scatter(df_lk[\"lon\"], df_lk[\"lat\"], c=df_lk[\"height\"],\n",
        "                          cmap=\"plasma\", s=6)\n",
        "    plt.colorbar(sc1, ax=axes[1], label=\"WSE (m)\")\n",
        "else:\n",
        "    axes[1].text(0.5, 0.5, \"No lake pixels\", ha=\"center\", va=\"center\",\n",
        "                 transform=axes[1].transAxes, fontsize=14)\n",
        "lake_gdf.boundary.plot(ax=axes[1], color=\"red\", lw=1)\n",
        "axes[1].set_title(f\"Lake pixels — {len(df_lk)} pts  |  \"\n",
        "                  f\"median={np.median(df_lk['height']):.3f} m\" if not df_lk.empty else \"Lake pixels — 0\")\n",
        "\n",
        "dt_label = get_granule_datetime(results[GRANULE_INDEX])[:19]\n",
        "plt.suptitle(f\"SWOT PIXC Version D  —  {dt_label}\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
