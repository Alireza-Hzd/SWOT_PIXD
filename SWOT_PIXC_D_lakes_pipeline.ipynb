            "  • 2025-01-22T16:05:42  SWOT_L2_HR_PIXC_027_251_229R_20250122T160542_20250122T160553_PGD0_01\n",
            "  • 2025-01-22T16:05:52  SWOT_L2_HR_PIXC_027_251_230R_20250122T160552_20250122T160603_PGD0_01\n",
            "  • 2025-01-31T01:10:42  SWOT_L2_HR_PIXC_027_486_079R_20250131T011042_20250131T011053_PGD0_01\n",
            "  • 2025-01-31T01:10:52  SWOT_L2_HR_PIXC_027_486_080R_20250131T011052_20250131T011103_PGD0_01\n",
            "  • 2025-02-10T23:33:38  SWOT_L2_HR_PIXC_028_208_080L_20250210T233338_20250210T233350_PGD0_02\n",
            "  • 2025-02-12T12:50:45  SWOT_L2_HR_PIXC_028_251_229R_20250212T125045_20250212T125057_PGD0_02\n",
            "  • 2025-02-12T12:50:55  SWOT_L2_HR_PIXC_028_251_230R_20250212T125055_20250212T125107_PGD0_02\n",
            "  • 2025-02-20T21:55:47  SWOT_L2_HR_PIXC_028_486_079R_20250220T215547_20250220T215558_PGD0_01\n"
          ]
        }
      ],
      "source": [
        "lon_min, lat_min, lon_max, lat_max = LAKE_BBOX\n",
        "\n",
        "results = earthaccess.search_data(\n",
        "    short_name   = SWOT_SHORT_NAME,\n",
        "    temporal     = (DATE_START, DATE_END),\n",
        "    bounding_box = (lon_min, lat_min, lon_max, lat_max),\n",
        ")\n",
        "\n",
        "print(f\"Found {len(results)} granule(s).\")\n",
        "for g in results[:20]:\n",
        "    try:\n",
        "        dt = g['umm']['TemporalExtent']['RangeDateTime']['BeginningDateTime']\n",
        "    except Exception:\n",
        "        dt = \"unknown\"\n",
        "    print(f\"  • {dt[:19]}  {g['umm']['GranuleUR']}\")"
